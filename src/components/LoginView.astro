---
// Anmeldeseite in zwei Schritten: E-Mail → Code aus der Mail → Sitzung.
// Die Logik liegt in pages.ts (loginPage); diese Seite zeigt nur den Stand.
//
//   const p = await loginPage(Astro, { allow: (u) => u?.role === 'admin' });
//   if (p.redirect) return Astro.redirect(p.redirect, 302);
//   <LoginView {...p} />
import { cms } from '../config';
import CodeFelder from './CodeFelder.astro';
import type { LoginPageData } from '../pages';

interface Props extends Omit<LoginPageData, 'redirect'> {
  brand?: string;
  accent?: string;
  /** Adresse dieser Seite, für „Andere Adresse“. */
  self?: string;
  lang?: string;
}
const {
  step, email, remember, error, days, showRemember,
  brand = cms().brand,
  accent = '#b91c1c',
  self = '/admin/login',
  lang = 'de',
} = Astro.props;
---
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Anmelden · {brand} Admin</title>
  <style is:global define:vars={{ accent }}>
    :root { --cms-accent: var(--accent); }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f5f5f4; font-family: system-ui, "Segoe UI", sans-serif; color: #1f2937; }
    .box { width: 23rem; max-width: 92vw; background: #fff; border: 1px solid #e7e5e4; border-radius: 8px; padding: 1.5rem; box-sizing: border-box; }
    .box h1 { margin: 0 0 .25rem; font-size: 1.25rem; }
    .box input[type=email] { width: 100%; padding: .55rem .7rem; border: 1px solid #d6d3d1; border-radius: 4px; font: inherit; box-sizing: border-box; }
    .box button[type=submit] { width: 100%; margin-top: 1rem; padding: .6rem; border: 0; border-radius: 4px; background: var(--cms-accent); color: #fff; font: inherit; cursor: pointer; }
    label.feld { display: block; font-size: .8rem; color: #57534e; margin: .8rem 0 .3rem; }
    label.haken { display: flex; align-items: center; gap: .5rem; font-size: .9rem; margin-top: .8rem; cursor: pointer; }
    .err { background: #fef2f2; border: 1px solid #ef4444; color: #991b1b; padding: .5rem .7rem; border-radius: 4px; font-size: .9rem; }
    .hint { font-size: .85rem; color: #57534e; }
    a { color: var(--cms-accent); }
  </style>
</head>
<body>
  <form method="post" class="box">
    <h1>{brand} Pflegeoberfläche</h1>
    {error && <div class="err">{error}</div>}
    {step === 'email' ? (
      <>
        <p class="hint">Sie erhalten einen Anmeldecode per E-Mail.</p>
        <input type="hidden" name="step" value="email" />
        <label class="feld" for="email">E-Mail-Adresse</label>
        <input id="email" name="email" type="email" value={email} required autofocus autocomplete="username" />
        {showRemember && (
          <label class="haken">
            <input type="checkbox" name="merken" checked={remember} />
            {days} Tage angemeldet bleiben
          </label>
        )}
        <button type="submit">Code anfordern</button>
      </>
    ) : (
      <>
        <p class="hint">Falls die Adresse bekannt ist, wurde ein Code an <strong>{email}</strong> geschickt. Er gilt 10 Minuten.</p>
        <input type="hidden" name="step" value="code" />
        <input type="hidden" name="email" value={email} />
        {remember && <input type="hidden" name="merken" value="on" />}
        <label class="feld">Code</label>
        <CodeFelder accent={accent} />
        <button type="submit">Anmelden</button>
        <p class="hint" style="margin-top:.8rem"><a href={self}>Andere Adresse</a></p>
      </>
    )}
  </form>
</body>
</html>
