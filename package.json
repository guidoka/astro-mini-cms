{
  "name": "astro-mini-cms",
  "version": "0.1.1",
  "description": "Kleines CMS für Astro-SSR-Projekte mit Postgres: Seitenbaum, Raster-Editor, Dateien, Anmeldung per E-Mail-Code. Bausteine zum Importieren, kein Framework.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Guido Kalter",
  "repository": "github:guidoka/astro-mini-cms",
  "keywords": [
    "astro",
    "astro-component"
  ],
  "files": [
    "src",
    "sql",
    "scripts",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./config": "./src/config.ts",
    "./auth": "./src/auth.ts",
    "./admin": "./src/admin.ts",
    "./files": "./src/files.ts",
    "./layout": "./src/layout.ts",
    "./content": "./src/content.ts",
    "./middleware": "./src/middleware.ts",
    "./routes": "./src/routes.ts",
    "./pages": "./src/pages.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/s3": "./src/storage/s3.ts",
    "./components/*": "./src/components/*",
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "astro-mini-cms-tinymce": "./scripts/copy-tinymce.js"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "astro": ">=5.0.0",
    "pg": "^8.0.0",
    "tinymce": "^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
